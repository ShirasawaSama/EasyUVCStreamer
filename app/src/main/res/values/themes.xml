<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SimpleUVCStreamer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/panel_stroke</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="materialSwitchStyle">@style/Widget.Uvc.Switch</item>
    </style>

    <style name="Theme.SimpleUVCStreamer" parent="Base.Theme.SimpleUVCStreamer" />

    <style name="Widget.Uvc.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <style name="Text.Uvc.Brand" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Uvc.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/signal</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Uvc.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Uvc.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Uvc.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Widget.Uvc.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/panel</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/panel_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
    </style>
</resources>
