diff --git a/src/stream.c b/src/stream.c
index b29c944..7834652 100644
--- a/src/stream.c
+++ b/src/stream.c
@@ -39,6 +39,7 @@
 #include "libuvc/libuvc.h"
 #ifdef __ANDROID__
 #include <android/log.h>
+#include <time.h>
 #endif
 #include "libuvc/libuvc_internal.h"
 #include "errno.h"
@@ -1527,6 +1528,35 @@ uvc_error_t uvc_stream_stop(uvc_stream_handle_t *strmh) {
       libusb_cancel_transfer(strmh->transfers[i]);
   }
 
+#if defined(__ANDROID__)
+  {
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_nsec += 500000000L; /* 500ms */
+    if (ts.tv_nsec >= 1000000000L) {
+      ts.tv_sec += 1;
+      ts.tv_nsec -= 1000000000L;
+    }
+    do {
+      for(i=0; i < LIBUVC_NUM_TRANSFER_BUFS; i++) {
+        if(strmh->transfers[i] != NULL)
+          break;
+      }
+      if(i == LIBUVC_NUM_TRANSFER_BUFS )
+        break;
+      if (pthread_cond_timedwait(&strmh->cb_cond, &strmh->cb_mutex, &ts) == ETIMEDOUT) {
+        __android_log_print(ANDROID_LOG_WARN, "libuvc",
+                            "uvc_stream_stop: timed out waiting for transfers (hot-unplug?)");
+        /* Abandon remaining transfers to unblock stop. Intentional leak if a
+         * late callback still fires — safer than UAF / infinite wait. */
+        for(i=0; i < LIBUVC_NUM_TRANSFER_BUFS; i++) {
+          strmh->transfers[i] = NULL;
+        }
+        break;
+      }
+    } while(1);
+  }
+#else
   /* Wait for transfers to complete/cancel */
   do {
     for(i=0; i < LIBUVC_NUM_TRANSFER_BUFS; i++) {
@@ -1537,6 +1567,7 @@ uvc_error_t uvc_stream_stop(uvc_stream_handle_t *strmh) {
       break;
     pthread_cond_wait(&strmh->cb_cond, &strmh->cb_mutex);
   } while(1);
+#endif
   // Kick the user thread awake
   pthread_cond_broadcast(&strmh->cb_cond);
   pthread_mutex_unlock(&strmh->cb_mutex);
